#!/bin/sh
# Nightly backup of Sickbay (installed to /etc/periodic/daily by setup-sickbay.sh).
#   $BACKUP_DIR/sickbay-<date>.tar.gz   mode 0600, in a 0700 directory, kept KEEP_DAYS days
# The archive holds sickbay.db (a consistent SQLite copy that passed PRAGMA integrity_check) and files/.
# It is health data: treat the copies like the live database.
# DATA_DIR, BACKUP_DIR, KEEP_DAYS and LOG may be overridden for a test run.
set -u
umask 077
DATA_DIR=${DATA_DIR:-/var/lib/sickbay}
BACKUP_DIR=${BACKUP_DIR:-/var/backups/sickbay}
KEEP_DAYS=${KEEP_DAYS:-14}
LOG=${LOG:-/var/log/sickbay-backup.log}
DB=$DATA_DIR/sickbay.db
STAMP=$(date +%Y-%m-%d)
OUT=$BACKUP_DIR/sickbay-$STAMP.tar.gz
WORK=
log() { echo "$(date '+%F %T') sickbay-backup: $*" >> "$LOG" 2>/dev/null || true; }
# shellcheck disable=SC2329  # run by the trap
cleanup() { rm -f "$OUT.part"; [ -n "$WORK" ] && rm -rf "$WORK"; return 0; }
trap cleanup EXIT

[ -f "$DB" ] || { log "no database at $DB yet, nothing to back up"; exit 0; }
if ! { mkdir -p "$BACKUP_DIR" && chmod 700 "$BACKUP_DIR"; }; then log "FAILED (cannot prepare $BACKUP_DIR)"; exit 1; fi
rm -f "$OUT.part"
WORK=$(mktemp -d "$BACKUP_DIR/.work.XXXXXX") || { log "FAILED (no work folder)"; exit 1; }

link_files() {
  if [ -d "$DATA_DIR/files" ]; then ln -s "$DATA_DIR/files" "$WORK/files"; else mkdir "$WORK/files"; fi
}

# The copy and the files are laid out as the archive will hold them; files/ is a link so nothing is duplicated.
if sqlite3 "$DB" ".backup '$WORK/sickbay.db'" \
  && [ "$(sqlite3 "$WORK/sickbay.db" 'PRAGMA integrity_check;')" = "ok" ] \
  && link_files \
  && tar -czhf "$OUT.part" -C "$WORK" sickbay.db files \
  && chmod 600 "$OUT.part" && mv -f "$OUT.part" "$OUT"; then
  log "ok ($(du -h "$OUT" | cut -f1))"
else
  log "FAILED"
  exit 1  # the trap removes the part file and the work folder
fi
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'sickbay-*.tar.gz' -mtime +"$KEEP_DAYS" -exec rm -f {} +
exit 0
