# Household defaults baked into dist/setup-sickbay.sh by installer/build.sh.
# Copy to deploy/deploy.env (git-ignored) and fill in your own values.
# They only matter on a FIRST install; after that /etc/conf.d/sickbay on the container is the source of truth.
# Values may not contain a double quote, backtick, dollar sign or backslash.

# The two users' emails: the only addresses admitted.
ALLOWED_EMAILS=alex@example.com,sam@example.com

# Display names for them.
USERS=alex@example.com=Alex,sam@example.com=Sam

# Cloudflare Zero Trust > Settings > team domain, and the AUD tag of Sickbay's own Access application.
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_AUD=

# Page title and home-screen name. Keep it neutral: it never names the condition.
APP_NAME=Logbook
