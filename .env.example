# Development settings for `python3 app.py`; see the top of settings.py. Copy to .env and export it yourself
# (nothing loads this file). On the server the installer writes /etc/conf.d/sickbay instead, and never DEV_EMAIL.
# Every setting below except DEV_EMAIL and DATA_DIR is also written by installer/setup-head.sh.
SICKBAY_PORT=8774
ALLOWED_EMAILS=alex@example.com,sam@example.com
USERS=alex@example.com=Alex,sam@example.com=Sam
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_AUD=
APP_NAME=Logbook
MAX_UPLOAD_MB=25
# Development only: admit requests from this machine (loopback, no Cloudflare headers) as this user.
# DEV_EMAIL=alex@example.com
# DATA_DIR=./data
